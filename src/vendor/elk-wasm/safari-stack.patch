+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use super::NetworkSimplexLayerer;
+    use crate::org::eclipse::elk::alg::layered::graph::{LGraph, LNode};
+
+    #[test]
+    fn layerer_dfs_preserves_recursive_preorder_with_shared_neighbors() {
+        let graph = LGraph::new();
+        let nodes: Vec<_> = (0..6).map(|_| LNode::new(&graph)).collect();
+        let adjacency = vec![vec![1, 2], vec![0, 2, 3], vec![0, 1, 4], vec![1], vec![2], vec![]];
+        let mut visited = vec![false; nodes.len()];
+        let mut component = Vec::new();
+
+        NetworkSimplexLayerer::dfs_flat(0, &adjacency, &nodes, &mut visited, &mut component);
+
+        let expected = [0, 1, 2, 4, 3];
+        assert_eq!(component.len(), expected.len());
+        for (node, idx) in component.iter().zip(expected) {
+            assert!(Arc::ptr_eq(node, &nodes[idx]));
+        }
+        assert_eq!(visited, vec![true, true, true, true, true, false]);
+    }
+
+    #[test]
+    fn layerer_dfs_handles_deep_connected_graph_without_native_recursion() {
+        let node_count = 20_000;
+        let graph = LGraph::new();
+        let nodes: Vec<_> = (0..node_count).map(|_| LNode::new(&graph)).collect();
+        let mut adjacency = vec![Vec::new(); node_count];
+        for idx in 1..node_count {
+            adjacency[idx - 1].push(idx);
+            adjacency[idx].push(idx - 1);
+        }
+        let mut visited = vec![false; node_count];
+        let mut component = Vec::new();
+
+        NetworkSimplexLayerer::dfs_flat(0, &adjacency, &nodes, &mut visited, &mut component);
+
+        assert_eq!(component.len(), nodes.len());
+        for (actual, expected) in component.iter().zip(&nodes) {
+            assert!(Arc::ptr_eq(actual, expected));
+        }
+        assert!(visited.iter().all(|&value| value));
+    }
+}
