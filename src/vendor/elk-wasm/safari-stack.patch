+#[cfg(test)]
+mod tests {
+    use super::{NGraph, NetworkSimplex};
+
+    fn setup<'a>(
+        graph: &'a mut NGraph,
+        layers: &[i32],
+        edges: &[(usize, usize, i32)],
+    ) -> NetworkSimplex<'a> {
+        let mut simplex = NetworkSimplex::for_graph(graph);
+        simplex.n_layer = layers.to_vec();
+        simplex.n_tree_node = vec![false; layers.len()];
+        simplex.node_edges = vec![Vec::new(); layers.len()];
+        simplex.edge_visited = vec![false; edges.len()];
+        simplex.e_tree = vec![false; edges.len()];
+        for (eid, &(source, target, delta)) in edges.iter().enumerate() {
+            simplex.e_src_id.push(source);
+            simplex.e_tgt_id.push(target);
+            simplex.e_delta.push(delta);
+            simplex.node_edges[target].push(eid);
+        }
+        for (eid, &(source, _, _)) in edges.iter().enumerate() {
+            simplex.node_edges[source].push(eid);
+        }
+        simplex
+    }
+
+    // Retain the original recursive behavior as an oracle for small graphs.
+    fn recursive_reference(simplex: &mut NetworkSimplex<'_>, nid: usize) -> usize {
+        let mut count = 1;
+        simplex.n_tree_node[nid] = true;
+        for cursor in 0..simplex.node_edges[nid].len() {
+            let eid = simplex.node_edges[nid][cursor];
+            if simplex.edge_visited[eid] {
+                continue;
+            }
+            simplex.edge_visited[eid] = true;
+            let other = if simplex.e_src_id[eid] == nid {
+                simplex.e_tgt_id[eid]
+            } else {
+                simplex.e_src_id[eid]
+            };
+            if simplex.e_tree[eid] {
+                count += recursive_reference(simplex, other);
+            } else if !simplex.n_tree_node[other]
+                && simplex.e_delta[eid]
+                    == simplex.n_layer[simplex.e_tgt_id[eid]]
+                        - simplex.n_layer[simplex.e_src_id[eid]]
+            {
+                simplex.e_tree[eid] = true;
+                simplex.tree_edge_ids.push(eid);
+                count += recursive_reference(simplex, other);
+            }
+        }
+        count
+    }
+
+    #[test]
+    fn tight_tree_dfs_preserves_recursive_edge_order_and_state() {
+        let mut seed = 79u32;
+        for _ in 0..100 {
+            let layers: Vec<_> = (0..25).map(|idx| idx / 3).collect();
+            let mut edges = Vec::new();
+            for source in 0..layers.len() {
+                for target in source + 1..layers.len() {
+                    seed = seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+                    if seed.is_multiple_of(5) {
+                        let delta = if seed.is_multiple_of(2) {
+                            layers[target] - layers[source]
+                        } else {
+                            1
+                        };
+                        edges.push((source, target, delta));
+                    }
+                }
+            }
+            let mut actual_graph = NGraph::new();
+            let mut expected_graph = NGraph::new();
+            let mut actual = setup(&mut actual_graph, &layers, &edges);
+            let mut expected = setup(&mut expected_graph, &layers, &edges);
+
+            // The second traversal also covers pre-existing tree edges.
+            for _ in 0..2 {
+                assert_eq!(
+                    actual.tight_tree_dfs(0),
+                    recursive_reference(&mut expected, 0)
+                );
+                assert_eq!(actual.tree_edge_ids, expected.tree_edge_ids);
+                assert_eq!(actual.e_tree, expected.e_tree);
+                assert_eq!(actual.edge_visited, expected.edge_visited);
+                assert_eq!(actual.n_tree_node, expected.n_tree_node);
+                actual.edge_visited.fill(false);
+                expected.edge_visited.fill(false);
+                actual.n_tree_node.fill(false);
+                expected.n_tree_node.fill(false);
+            }
+        }
+    }
+
+    #[test]
+    fn tight_tree_dfs_handles_deep_graph_without_native_recursion() {
+        let node_count = 20_000;
+        let layers: Vec<_> = (0..node_count as i32).collect();
+        let edges: Vec<_> = (1..node_count).map(|idx| (idx - 1, idx, 1)).collect();
+        let mut graph = NGraph::new();
+        let mut simplex = setup(&mut graph, &layers, &edges);
+
+        assert_eq!(simplex.tight_tree_dfs(0), node_count);
+        assert_eq!(simplex.tree_edge_ids, (0..node_count - 1).collect::<Vec<_>>());
+        assert!(simplex.n_tree_node.iter().all(|&value| value));
+        assert!(simplex.edge_visited.iter().all(|&value| value));
+    }
+}
