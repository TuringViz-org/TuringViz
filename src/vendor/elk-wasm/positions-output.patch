+
+/// Run the same complete layout pipeline, returning only root and direct-child
+/// geometry for flat, unlabelled layered graphs. Unsupported graph structures
+/// and options retain the ordinary full JSON result, including exporter fixes.
+/// Every returned position and dimension uses the ordinary JSON conversion.
+pub fn layout_positions_json(graph_json: &str, options_json: &str) -> Result<String, String> {
+    layout_json_impl(graph_json, options_json, true)
+}
+
+// The compact export is safe only when no export-time hierarchy, port, label,
+// or coordinate-mode corrections can affect node geometry. Everything else
+// still runs the ordinary exporter after the identical layout pipeline.
+fn supports_flat_positions(input: &Value) -> bool {
+    use std::collections::HashSet;
+    fn options_ok(value: Option<&Value>) -> bool {
+        let Some(value) = value else {
+            return true;
+        };
+        let Some(options) = value.as_object() else {
+            return false;
+        };
+        options.iter().all(|(key, value)| {
+            let key = key
+                .strip_prefix("org.eclipse.elk.")
+                .or_else(|| key.strip_prefix("elk."))
+                .unwrap_or(key);
+            if key == "algorithm" {
+                return matches!(value.as_str(), Some("layered" | "org.eclipse.elk.layered"));
+            }
+            matches!(
+                key,
+                "direction"
+                    | "spacing.nodeNode"
+                    | "layered.spacing.nodeNodeBetweenLayers"
+                    | "spacing.edgeEdge"
+                    | "spacing.edgeNode"
+                    | "padding"
+                    | "layered.nodePlacement.bk.fixedAlignment"
+            ) && (value.is_string() || value.is_number())
+        })
+    }
+    fn node_ok(node: &Value, root: bool) -> bool {
+        node.as_object().is_some_and(|node| {
+            node.keys().all(|key| {
+                matches!(
+                    key.as_str(),
+                    "id" | "x" | "y" | "width" | "height" | "layoutOptions"
+                ) || (root && matches!(key.as_str(), "children" | "edges"))
+            })
+        }) && node.get("id").is_some_and(Value::is_string)
+            && options_ok(node.get("layoutOptions"))
+    }
+    if !node_ok(input, true) {
+        return false;
+    }
+    let Some(children) = input.get("children").and_then(Value::as_array) else {
+        return false;
+    };
+    let Some(edges) = input.get("edges").and_then(Value::as_array) else {
+        return false;
+    };
+    let mut ids = HashSet::new();
+    ids.insert(input["id"].as_str().unwrap());
+    let mut node_ids = HashSet::new();
+    for node in children {
+        if !node_ok(node, false) {
+            return false;
+        }
+        let id = node["id"].as_str().unwrap();
+        if !ids.insert(id) {
+            return false;
+        }
+        node_ids.insert(id);
+    }
+    for edge in edges {
+        let Some(object) = edge.as_object() else {
+            return false;
+        };
+        if !object
+            .keys()
+            .all(|key| matches!(key.as_str(), "id" | "sources" | "targets" | "container"))
+        {
+            return false;
+        }
+        let Some(id) = edge.get("id").and_then(Value::as_str) else {
+            return false;
+        };
+        if !ids.insert(id) {
+            return false;
+        }
+        if edge
+            .get("container")
+            .is_some_and(|container| container != &input["id"])
+        {
+            return false;
+        }
+        for endpoint in ["sources", "targets"] {
+            let Some(endpoints) = edge.get(endpoint).and_then(Value::as_array) else {
+                return false;
+            };
+            if endpoints.len() != 1
+                || !endpoints[0]
+                    .as_str()
+                    .is_some_and(|id| node_ids.contains(id))
+            {
+                return false;
+            }
+        }
+    }
+    true
+}
