+    // Used only after layout_api validates the conservative flat-graph contract.
+    // Original JSON order and the full exporter's number conversion are retained.
+    pub(crate) fn flat_layout_positions(&self, graph: &ElkNodeRef) -> JsonResult<Value> {
+        fn shape_value(node: &ElkNodeRef, id: Value) -> Value {
+            let mut node = node.borrow_mut();
+            let shape = node.connectable().shape();
+            serde_json::json!({"id": id, "x": f64_to_number(shape.x()), "y": f64_to_number(shape.y()), "width": f64_to_number(shape.width()), "height": f64_to_number(shape.height())})
+        }
+        let shared = self
+            .input_model
+            .as_ref()
+            .ok_or_else(|| JsonImportException::new("No input model available."))?;
+        let input = shared.borrow();
+        let mut output = shape_value(graph, input["id"].clone());
+        let mut children = Vec::new();
+        if let Some(input_children) = input.get("children").and_then(Value::as_array) {
+            for child in input_children {
+                let object = child
+                    .as_object()
+                    .ok_or_else(|| JsonImportException::new("Invalid child."))?;
+                let id = JsonAdapter::get_id(object)?;
+                let node = self
+                    .node_id_map
+                    .get(&id)
+                    .ok_or_else(|| JsonImportException::new("Missing child node."))?;
+                children.push(shape_value(node, child["id"].clone()));
+            }
+        }
+        output["children"] = Value::Array(children);
+        Ok(output)
     }
 
