+    fn project_flat_geometry(full: &Value) -> Value {
+        fn shape(node: &Value) -> Value {
+            json!({"id": node["id"], "x": node["x"], "y": node["y"],
+                "width": node["width"], "height": node["height"]})
+        }
+        let mut output = shape(full);
+        output["children"] = full["children"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(shape)
+            .collect();
+        output
+    }
+
+    fn positions_test_graph() -> Value {
+        json!({
+            "id": "root", "x": 17, "y": 23,
+            "layoutOptions": {"elk.algorithm": "layered", "elk.direction": "RIGHT"},
+            "children": [
+                {"id": "z", "width": 64, "height": 48},
+                {"id": "b", "width": 96, "height": 31},
+                {"id": "a", "width": 33, "height": 80},
+                {"id": "isolated", "width": 17, "height": 11}
+            ],
+            "edges": [
+                {"id": "za", "sources": ["z"], "targets": ["a"]},
+                {"id": "zb", "sources": ["z"], "targets": ["b"]},
+                {"id": "ba", "sources": ["b"], "targets": ["a"]},
+                {"id": "az", "sources": ["a"], "targets": ["z"]},
+                {"id": "aa", "sources": ["a"], "targets": ["a"]}
+            ]
+        })
+    }
+
+    #[test]
+    fn positions_export_preserves_exact_geometry_and_order() {
+        for direction in ["RIGHT", "DOWN", "LEFT", "UP"] {
+            let mut graph = positions_test_graph();
+            graph["layoutOptions"]["elk.direction"] = json!(direction);
+            assert!(supports_flat_positions(&graph));
+            let graph = graph.to_string();
+            let options = "{}";
+            let full: Value = serde_json::from_str(&layout_json(&graph, options).unwrap()).unwrap();
+            let positions: Value =
+                serde_json::from_str(&layout_positions_json(&graph, options).unwrap()).unwrap();
+            assert_eq!(
+                positions,
+                project_flat_geometry(&full),
+                "direction {direction}"
+            );
+            assert!(positions.get("edges").is_none());
+        }
+    }
+
+    #[test]
+    fn positions_export_preserves_empty_and_omitted_children() {
+        for graph in [
+            json!({"id": "root"}),
+            json!({"id": "root", "children": []}),
+            json!({"id": "root", "children": [], "edges": []}),
+        ] {
+            let text = graph.to_string();
+            let full: Value = serde_json::from_str(&layout_json(&text, "{}").unwrap()).unwrap();
+            let positions: Value =
+                serde_json::from_str(&layout_positions_json(&text, "{}").unwrap()).unwrap();
+            if supports_flat_positions(&graph) {
+                assert_eq!(positions, project_flat_geometry(&full));
+            } else {
+                assert_eq!(positions, full);
+            }
+        }
+    }
+
+    #[test]
+    fn positions_export_falls_back_for_richer_graphs_and_options() {
+        let mut labelled = positions_test_graph();
+        labelled["children"][0]["labels"] = json!([{"text": "A label", "width": 80, "height": 15}]);
+        let mut ports = positions_test_graph();
+        ports["children"][0]["ports"] = json!([{"id": "port", "width": 5, "height": 5}]);
+        ports["edges"][0]["sources"] = json!(["port"]);
+        let mut hierarchy = positions_test_graph();
+        hierarchy["children"][0]["children"] = json!([{"id": "nested", "width": 50, "height": 20}]);
+        let mut coordinates = positions_test_graph();
+        coordinates["layoutOptions"]["org.eclipse.elk.json.shapeCoords"] = json!("ROOT");
+        let mut unknown = positions_test_graph();
+        unknown["layoutOptions"]["org.eclipse.elk.aspectRatio"] = json!(1.7);
+        let mut metadata = positions_test_graph();
+        metadata["customMetadata"] = json!({"preserve": true});
+        for graph in [labelled, ports, hierarchy, coordinates, unknown, metadata] {
+            assert!(!supports_flat_positions(&graph));
+            let text = graph.to_string();
+            assert_eq!(layout_positions_json(&text, "{}"), layout_json(&text, "{}"));
+        }
+        let text = positions_test_graph().to_string();
+        for options in [
+            r#"{"org.eclipse.elk.json.shapeCoords":"ROOT"}"#,
+            r#"{"org.eclipse.elk.spacing.nodeNode":35}"#,
+        ] {
+            // Global defaults are merged onto edges too; edge options retain
+            // the conservative full-export fallback, even for known keys.
+            assert_eq!(
+                layout_positions_json(&text, options),
+                layout_json(&text, options)
+            );
+        }
+    }
+
+    #[test]
+    fn positions_export_falls_back_for_other_algorithms() {
+        for algorithm in ["force", "mrtree", "radial", "stress"] {
+            let mut graph = positions_test_graph();
+            graph["layoutOptions"]["elk.algorithm"] = json!(algorithm);
+            graph["edges"] = json!([
+                {"id":"za", "sources":["z"], "targets":["a"]},
+                {"id":"zb", "sources":["z"], "targets":["b"]}
+            ]);
+            assert!(!supports_flat_positions(&graph));
+            let text = graph.to_string();
+            assert_eq!(layout_positions_json(&text, "{}"), layout_json(&text, "{}"));
+        }
+    }
+
+    #[test]
+    fn positions_export_rejects_unsupported_references_and_preserves_errors() {
+        let mut duplicate = positions_test_graph();
+        duplicate["children"][0]["id"] = json!("a");
+        let mut missing = positions_test_graph();
+        missing["edges"][0]["targets"] = json!(["missing"]);
+        let mut hyperedge = positions_test_graph();
+        hyperedge["edges"][0]["targets"] = json!(["a", "b"]);
+        let mut invalid_container = positions_test_graph();
+        invalid_container["edges"][0]["container"] = json!("a");
+        for graph in [duplicate, missing, hyperedge, invalid_container] {
+            assert!(!supports_flat_positions(&graph));
+        }
+        for (graph, options) in [("{", "{}"), ("{}", "{}"), ("{\"id\":\"root\"}", "{")] {
+            assert_eq!(
+                layout_positions_json(graph, options),
+                layout_json(graph, options)
+            );
+        }
+    }
+}
